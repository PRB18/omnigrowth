# OmniGrowth Environment Variables
# Copy values into the right file. NEVER commit real secrets.

# ─── client/.env (safe for Vite — these are embedded in the browser bundle) ─
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# ─── repo-root .env (server / cron / sync scripts ONLY — never VITE_ prefix) ─
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key
# DATA_GOV_API_KEY=your_data_gov_in_api_key
#
# Used by: node client/scripts/sync-prices.mjs
# Catalog: Current daily price of various commodities from various markets (Mandi)
# Never put SERVICE_ROLE / SECRET / DATA_GOV keys in client/.env or any VITE_* variable.
